# Local only — copy to .env.local, NEVER commit .env.local, NEVER send real values in chat
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=
ADMIN_PATH=/admin
TZ=Asia/Dhaka
DEFAULT_LOCALE=bn
DEFAULT_CURRENCY=BDT

# Database / Redis — put YOUR local values in .env.local only, not here, not in repo
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=redis://localhost:6379

# Auth secret — generate a random 32+ char string, keep in .env.local only
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Auth encryption key — 64 hex chars (32 bytes), server env only.
# Encrypts TOTP secrets at rest and signs the pending-2FA cookie (see src/lib/SECURITY-NOTES.md).
# Rotating it invalidates enrolled TOTP secrets (staff re-enrol) — plan rotations.
AUTH_ENCRYPTION_KEY=
# Settings encryption key — 64 hex chars (32 bytes), encrypts Admin Settings secrets at rest
SETTINGS_ENCRYPTION_KEY=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Search — Meilisearch (assistant choice), local fallback Postgres if not running
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Storage / Email / SMS / Payment / Courier — DEFAULTS only here.
# Real credentials are set from Admin > Settings (encrypted in DB), NOT in this file for production use.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
NEXT_PUBLIC_CDN_URL=
EMAIL_PROVIDER=resend
# Fallback sender address only — the real one is email.from_address in
# Admin > Settings. (EMAIL_FROM is NOT read by any code.)
EMAIL_FROM_ADDRESS=
# SMTP transport (email.provider=smtp) is configured in Admin >
# Settings (email.smtp.host/port/secure/user/password, encrypted) —
# there is no env fallback for SMTP credentials. Reference only:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
SMS_PROVIDER=

# Web Push (VAPID) — server-side only. Generate once with
# generateVapidKeys() from src/platform/push-server.ts. When unset,
# push sending reports NOT_CONFIGURED and subscribe UI says so honestly.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
