// Merged schema — Phase 1 Foundation + Catalog + Orders/Cart/CRM + Payment/Courier + Inventory + Marketing
// Merged by Agent 6 from the three SCHEMA-ADDITIONS.md proposals (catalog, orders, integrations).
// Resolution rule: ONE canonical model per concept. Duplicates resolved:
//   payments/payment_attempts (orders + integrations) -> Payment / PaymentAttempt (one model each)
//   shipments/shipment_events (orders + integrations) -> Shipment / ShipmentEvent (one model each)
//   refunds (orders + integrations) -> Refund (one model, sum <= paidPoisha enforced in service)
// Money: integer poisha (Int), never Float/Decimal for money. Phone: normalized +8801XXXXXXXXX.
// Soft delete: deletedAt on business entities. StockMovement is append-only: never update/delete a row.
// Secrets are NEVER stored here: provider credentials live in Setting (valueEncrypted) / CourierAccount.credentialRef.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  FAILED
  RETURN_REQUESTED
  RETURNING
  RETURNED
  CANCELLED
  REFUNDED
  EXCHANGED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  UPAY
  SSLCOMMERZ
  AAMARPAY
  SHURJOPAY
  STRIPE
  PAYPAL
  MANUAL_MOBILE_BANKING
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNING
  RETURNED
}

enum StockMovementType {
  PURCHASE_RECEIVE
  SALE_RESERVE
  SALE_COMMIT
  SALE_RELEASE
  SALE_RESTORE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_RECEIVE
  DAMAGE
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
  FIRST_ORDER
}

enum ManualTrxStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  RETURNING
  RETURNED
  REFUNDED
  EXCHANGED
}

enum NotificationChannel {
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum CampaignChannel {
  SMS
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  COMPLETED
}

// ---------------------------------------------------------------- Phase 1
model User {
  id                  String    @id @default(cuid())
  email               String?   @unique
  phone               String?   @unique
  passwordHash        String
  name                String?
  roleId              String?
  role                Role?     @relation(fields: [roleId], references: [id])
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  // Two-factor secret must be stored encrypted by the auth layer, never plain in logs/API.
  locale              String    @default("bn")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  isActive            Boolean   @default(true)
  deletedAt           DateTime?
  // Staff invite lifecycle (additive): an invited user is created inactive
  // with only the SHA-256 hash of a random invite token; the raw token is
  // shown once to the inviter and never stored or logged. Accepting the
  // invite sets a real password, activates the account and clears these.
  inviteTokenHash     String?
  inviteExpiresAt     DateTime?
  invitedById         String?
  invitedBy           User?     @relation("UserInvites", fields: [invitedById], references: [id])
  invitesSent         User[]    @relation("UserInvites")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  assignedOrders      Order[]   @relation("OrderAssignee")
  approvedPayments    Payment[] @relation("PaymentApprover")
  reviewedTrx         ManualTrxSubmission[] @relation("TrxReviewer")
  statusChanges       OrderStatusHistory[] @relation("StatusChanger")
  orderNotes          OrderNote[] @relation("NoteAuthor")
  stockMovements      StockMovement[] @relation("MovementActor")
  @@index([phone])
  @@index([deletedAt])
  @@index([inviteTokenHash])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  deviceName String?
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  phone      String?
  email      String?
  codeHash   String
  purpose    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  @@index([phone, purpose, expiresAt])
  @@index([email, purpose, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, expiresAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  phone     String?
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key            String   @id
  value          String
  valueEncrypted Boolean  @default(false)
  isPublic       Boolean  @default(false)
  description    String?
  category       String
  updatedById    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  @@index([category])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model Division {
  id        String     @id @default(cuid())
  nameEn    String
  nameBn    String
  code      String?
  districts District[]
}

model District {
  id         String    @id @default(cuid())
  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id])
  nameEn     String
  nameBn     String
  code       String?
  upazilas   Upazila[]
}

model Upazila {
  id         String   @id @default(cuid())
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  nameEn     String
  nameBn     String
  code       String?
  unions     Union[]
}

model Union {
  id        String  @id @default(cuid())
  upazilaId String
  upazila   Upazila @relation(fields: [upazilaId], references: [id])
  nameEn    String
  nameBn    String
}

// ---------------------------------------------------------------- Catalog
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameBn    String
  nameEn    String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  @@index([parentId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  titleBn          String
  titleEn          String
  descriptionBn    String           @db.Text
  descriptionEn    String           @db.Text
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  status           String           @default("DRAFT")
  tags             String[]
  ratingAverage    Float?
  reviewCount      Int              @default(0)
  seoTitleBn       String?
  seoTitleEn       String?
  seoDescriptionBn String?
  seoDescriptionEn String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  images           ProductImage[]
  variants         ProductVariant[]
  flashSaleItems   FlashSaleItem[]
  vendorProducts   VendorProduct[]
  reviews          Review[]
  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  attributes      Json
  sku             String   @unique
  barcode         String?  @unique
  pricePoisha     Int
  compareAtPoisha Int?
  costPoisha      Int?
  // Denormalized cache only; stock_movements ledger is the source of truth.
  stock           Int      @default(0)
  imageUrl        String?
  isActive        Boolean  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventoryItems  InventoryItem[]
  stockMovements  StockMovement[]
  flashSaleItems  FlashSaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  vendorProducts  VendorProduct[]
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  altBn     String
  altEn     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  @@index([productId])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  key       String   @unique
  labelBn   String
  labelEn   String
  values    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------- Reviews
// Customer product reviews. A review is born PENDING and only becomes
// public on admin APPROVAL (see /admin/reviews). `phone` is stored in
// normalized +8801XXXXXXXXX form for verification (matching the
// reviewer to a Customer / delivered Order) and is NEVER exposed on
// public reads — public views carry the author's name only.
// Product.ratingAverage / reviewCount are the denormalized aggregate
// over APPROVED, non-deleted reviews, maintained by the reviews store.
model Review {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  orderId    String?
  authorName String
  phone      String
  rating     Int
  title      String?
  body       String
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  @@index([productId, status])
  @@index([status, createdAt])
}

// ------------------------------------------------------- Contact inbox
// Storefront "contact us" form submissions (public /contact). Written
// via POST /api/v1/public/contact; read/triaged in the admin inbox.
// status: NEW | READ | RESOLVED (free String, set by the API layer).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

// ---------------------------------------------------------------- Customer / Cart
model Customer {
  id                  String    @id @default(cuid())
  name                String
  phone               String    @unique
  email               String?
  tags                String[]
  blocked             Boolean   @default(false)
  blacklistReason     String?
  // Customer account auth (nullable: guest customers created by checkout
  // have no password until they register with the same phone).
  passwordHash        String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  couponUsages        CouponUsage[]
  sessions            CustomerSession[]
  reviews             Review[]
  @@index([phone])
  @@index([deletedAt])
}

// Customer web sessions — mirrors the staff Session model, but keyed to
// Customer and NEVER interchangeable with staff sessions (separate table,
// separate cookie `customer_session`).
model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  deviceName String?
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  @@index([customerId])
  @@index([expiresAt])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  label       String?
  division    String
  district    String
  upazila     String
  union       String?
  addressLine String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([customerId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  guestKey   String?    @unique
  couponCode String?
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
  @@index([customerId])
}

model CartItem {
  id              String         @id @default(cuid())
  cartId          String
  cart            Cart           @relation(fields: [cartId], references: [id])
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  unitPricePoisha Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@unique([cartId, variantId])
  @@index([variantId])
}

// ---------------------------------------------------------------- Order
model Order {
  id               String       @id @default(cuid())
  orderNo          String       @unique
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id])
  customerName     String
  customerPhone    String
  division         String
  district         String
  upazila          String
  union            String?
  addressLine      String
  status           OrderStatus  @default(PENDING)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(UNPAID)
  subtotalPoisha   Int
  discountPoisha   Int          @default(0)
  shippingPoisha   Int          @default(0)
  codFeePoisha     Int          @default(0)
  taxPoisha        Int          @default(0)
  // Recorded VAT split (wave 7): written at order-create time ONLY when
  // a VAT rate is configured in Settings (accounting.vat_rate_bps).
  // totalPoisha is VAT-inclusive, so vatPoisha is the VAT portion of
  // the total at vatRateBps. NULL on every order placed without a
  // configured rate — the ERP sales-VAT report reads only rows where
  // both are set, and never reconstructs a split after the fact.
  vatPoisha        Int?
  vatRateBps       Int?
  totalPoisha      Int
  courier          String?
  trackingId       String?
  riskScore        Int          @default(0)
  assigneeId       String?
  assignee         User?        @relation("OrderAssignee", fields: [assigneeId], references: [id])
  // Reseller attribution (nullable: set only when the order is recorded
  // as a reseller sale; the delivered-order hook credits this reseller).
  resellerId       String?
  reseller         Reseller?    @relation(fields: [resellerId], references: [id])
  source           String?
  idempotencyKey   String       @unique
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  items            OrderItem[]
  history          OrderStatusHistory[]
  notes            OrderNote[]
  tags             OrderTag[]
  payments         Payment[]
  manualTrx        ManualTrxSubmission[]
  shipments        Shipment[]
  returns          Return[]
  couponUsages     CouponUsage[]
  notificationLogs NotificationLog[]
  paymentLinks     PaymentLink[]
  vendorCommissionLines VendorCommissionLine[]
  vendorRefunds    VendorRefund[]
  @@index([customerId])
  @@index([resellerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  productName     String
  sku             String
  unitPricePoisha Int
  quantity        Int
  createdAt       DateTime       @default(now())
  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  from        OrderStatus?
  to          OrderStatus
  changedById String?
  changedBy   User?       @relation("StatusChanger", fields: [changedById], references: [id])
  reason      String?
  createdAt   DateTime    @default(now())
  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  authorId  String?
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id])
  text      String   @db.Text
  createdAt DateTime @default(now())
  @@index([orderId])
}

model OrderTag {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  tag       String
  createdAt DateTime @default(now())
  @@index([orderId])
  @@index([tag])
}

model Return {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  type            ReturnType
  reason          String
  status          ReturnStatus @default(REQUESTED)
  qcNote          String?
  restockDecision String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@index([orderId])
}

// ---------------------------------------------------------------- Payment (canonical)
model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  method                PaymentMethod
  amountPoisha          Int
  paidPoisha            Int           @default(0)
  status                PaymentStatus @default(UNPAID)
  gatewayTransactionId  String?
  senderNumber          String?
  approvedById          String?
  approvedBy            User?         @relation("PaymentApprover", fields: [approvedById], references: [id])
  approvedAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  attempts              PaymentAttempt[]
  manualTrx             ManualTrxSubmission[]
  refunds               Refund[]
  @@unique([method, gatewayTransactionId])
  @@index([orderId])
  @@index([status])
}

model PaymentAttempt {
  id                   String   @id @default(cuid())
  paymentId            String
  payment              Payment  @relation(fields: [paymentId], references: [id])
  orderId              String
  method               PaymentMethod
  amountPoisha         Int
  status               PaymentStatus
  gatewayTransactionId String?
  gatewayResponseRef   String?
  idempotencyKey       String?  @unique
  createdAt            DateTime @default(now())
  @@index([paymentId])
  @@index([orderId])
}

model ManualTrxSubmission {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id])
  paymentId    String?
  payment      Payment?        @relation(fields: [paymentId], references: [id])
  method       PaymentMethod
  trxId        String
  senderPhone  String
  amountPoisha Int
  status       ManualTrxStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?           @relation("TrxReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  submittedAt  DateTime        @default(now())
  reviewedAt   DateTime?
  @@unique([method, trxId])
  @@index([orderId])
  @@index([status])
}

model Refund {
  id           String   @id @default(cuid())
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id])
  orderId      String
  amountPoisha Int
  reason       String
  method       PaymentMethod
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  @@index([paymentId])
  @@index([orderId])
}

// ---------------------------------------------------------------- Courier (canonical)
model Shipment {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  provider         String
  trackingId       String?        @unique
  status           ShipmentStatus @default(CREATED)
  codAmountPoisha  Int            @default(0)
  chargePoisha     Int            @default(0)
  weightGrams      Int?
  labelUrl         String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  events           ShipmentEvent[]
  @@index([orderId])
  @@index([status])
}

model ShipmentEvent {
  id               String   @id @default(cuid())
  shipmentId       String
  shipment         Shipment @relation(fields: [shipmentId], references: [id])
  status           ShipmentStatus
  providerRawStatus String?
  location         String?
  idempotencyKey   String?  @unique
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  @@index([shipmentId])
}

model CourierAccount {
  id            String   @id @default(cuid())
  provider      String
  enabled       Boolean  @default(false)
  mode          String   @default("sandbox")
  credentialRef String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([provider])
}

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  district  String?
  createdAt DateTime       @default(now())
  rates     ShippingRate[]
  @@index([district])
}

model ShippingRate {
  id              String       @id @default(cuid())
  zoneId          String
  zone            ShippingZone @relation(fields: [zoneId], references: [id])
  provider        String?
  minWeightGrams  Int          @default(0)
  maxWeightGrams  Int?
  chargePoisha    Int
  freeAbovePoisha Int?
  createdAt       DateTime     @default(now())
  @@index([zoneId])
}

// ---------------------------------------------------------------- Inventory
model Warehouse {
  id             String          @id @default(cuid())
  name           String
  addressRef     String?
  isActive       Boolean         @default(true)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
}

model InventoryItem {
  id               String         @id @default(cuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  updatedAt        DateTime       @updatedAt
  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id            String            @id @default(cuid())
  variantId     String
  variant       ProductVariant    @relation(fields: [variantId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  type          StockMovementType
