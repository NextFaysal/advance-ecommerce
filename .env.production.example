# =============================================================================
# advance-ecommerce — PRODUCTION environment for docker-compose.prod.yml
#
# Copy this file to `.env` in the SAME folder as docker-compose.prod.yml
# on the VPS (in Dokploy: paste these into the Compose service's
# Environment tab), fill in real values, and NEVER commit the real `.env`
# or send its values in chat.
#
# Generate each secret with:   openssl rand -hex 32
# (64 hex chars = 32 bytes. Use a DIFFERENT value for every secret.)
# =============================================================================

# --- Required: you must set these -------------------------------------------

# Postgres password (the compose file builds every DATABASE_URL from it).
POSTGRES_PASSWORD=

# Meilisearch master key (also handed to web/worker as the API key).
MEILI_MASTER_KEY=

# Session/auth secret.
NEXTAUTH_SECRET=

# 64 hex chars. Encrypts TOTP secrets at rest + signs the pending-2FA
# cookie. Rotating it invalidates enrolled TOTP secrets (staff re-enrol).
AUTH_ENCRYPTION_KEY=

# 64 hex chars. Encrypts Admin > Settings secrets at rest (payment/SMS/
# courier credentials). Rotating it makes stored settings unreadable.
SETTINGS_ENCRYPTION_KEY=

# Public address of the store — your domain once DNS is wired
# (e.g. https://shop.example.com). NEXT_PUBLIC_* values are baked into
# the web image at BUILD time: changing this needs a rebuild.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=

# Host port the web container publishes on. Dokploy/Traefik usually
# routes to 3000 — leave it unless the port is taken.
# WEB_PORT is no longer used: the web container publishes no host port (Dokploy/Traefik routes the domain to it over dokploy-network).
# WEB_PORT=3001

# --- Optional -----------------------------------------------------------------

# Canonical URL for auth callbacks. Defaults to empty; set it to the
# same value as NEXT_PUBLIC_APP_URL if you use OAuth sign-in.
# NEXTAUTH_URL=

# First-Owner bootstrap — do NOT put these in the stack env. With CI
# image builds, the Owner is created once by running the bootstrap
# inside the running web container with these passed inline
# (see DOCKER-DEPLOY.md §3). Never in chat or git.

# Only if binaries.prisma.sh is unreachable from the VPS during builds:
# PRISMA_ENGINES_MIRROR=https://cdn.npmmirror.com/binaries/prisma

# Object storage (Cloudflare R2 / S3) + CDN. Real provider credentials
# (payment, SMS, email, courier) belong in Admin > Settings, not here.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# NEXT_PUBLIC_CDN_URL=
# EMAIL_PROVIDER=resend
# Fallback sender address only — the real one is email.from_address in
# Admin > Settings. (EMAIL_FROM is NOT read by any code.)
# EMAIL_FROM_ADDRESS=
# SMTP transport (email.provider=smtp) is configured in Admin >
# Settings (email.smtp.host/port/secure/user/password, encrypted) —
# there is no env fallback for SMTP credentials. Reference only:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMS_PROVIDER=
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=
